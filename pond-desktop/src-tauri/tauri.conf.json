{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goose In A Pond",
  "version": "0.1.0",
  "identifier": "app.goose-in-a-pond.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "canvas",
        "title": "GIAP Canvas",
        "url": "canvas.html",
        "width": 400,
        "height": 600,
        "minWidth": 300,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI assistant for your home network.",
    "longDescription": "Goose In A Pond is a private, local-first AI assistant. It runs LLM, speech recognition, text-to-speech, and face identification entirely on your own hardware — no data ever leaves the device.",
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
