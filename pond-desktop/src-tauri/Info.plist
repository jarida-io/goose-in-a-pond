<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSMicrophoneUsageDescription</key>
    <string>Goose In A Pond uses the microphone for voice commands and wake word detection.</string>
    <key>NSCameraUsageDescription</key>
    <string>Goose In A Pond uses the camera for face-based user recognition during enrollment and wake-on-face identification.</string>
    <!-- Required, not optional, and the consequence of omitting it is not a
         refused radio: macOS SIGKILLs a process that touches CoreBluetooth
         without this key. Verified — the crash report reads, verbatim, "This app
         has crashed because it attempted to access privacy-sensitive data
         without a usage description. The app's Info.plist must contain an
         NSBluetoothAlwaysUsageDescription key". The Matter controller is a bare
         `node` with no bundle of its own, so macOS attributes the permission to
         the responsible process at the root of its tree -- this app, when it is
         the app that launched pond-server. BLE is how a device that has never
         been on the network is paired at all, and it stays off until the user
         turns it on. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Goose In A Pond uses Bluetooth to set up new smart-home devices, which announce themselves over Bluetooth before they are on your network.</string>

    <!-- Launch Services / Finder integration. Without these the .app can copy
         into /Applications but Finder won't index it (so it never appears in
         Launchpad or the Applications grid until you reboot or run
         `killall Finder`). LSApplicationCategoryType also fixes the App Store
         category badge and makes Spotlight return the app for keyword search. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <!-- Keep the app on screen / dock — explicitly NOT a UI element / agent. -->
    <key>LSUIElement</key>
    <false/>
    <key>LSBackgroundOnly</key>
    <false/>
</dict>
</plist>
