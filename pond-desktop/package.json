{
  "name": "pond-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Privacy-first, fully local AI smart home assistant",
  "author": "Jarida Open Source Community",
  "license": "Apache-2.0",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n vite,server -c cyan,green \"vite\" \"npm run dev:server\"",
    "dev:server": "cd .. && cargo run -p pond-server -- serve --native",
    "dev:server:mesh": "cd .. && cargo run -p pond-server --features mesh -- serve --native",
    "dev:mesh": "concurrently --kill-others-on-fail -n vite,server -c cyan,green \"vite\" \"npm run dev:server:mesh\"",
    "dev:vite": "vite",
    "dev:electron": "concurrently --kill-others-on-fail -n vite,main,shell -c cyan,yellow,magenta \"vite\" \"tsup --watch\" \"wait-on tcp:1420 dist-electron/main/index.cjs && GIAP_DEV_SERVER=http://localhost:1420 electron .\"",
    "build": "vite build",
    "build:main": "tsup",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "lint": "eslint .",
    "stage:server": "bash ../scripts/stage-server-sidecar.sh",
    "bundle:app": "npm run stage:server && npm run build:main && bash ../scripts/verify-sidecar.sh && electron-builder --mac",
    "pack:dir": "npm run stage:server && npm run build:main && bash ../scripts/verify-sidecar.sh && electron-builder --mac dir"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@heroui/react": "^3.2.6",
    "@jarida/ink": "^1.0.0",
    "framer-motion": "^14.1.0",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.2.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "tsup": {
      "esbuild": "^0.28.1"
    },
    "@electron/get": {
      "global-agent": "^4.1.3"
    },
    "concurrently": {
      "shell-quote": "1.11.0"
    }
  }
}
