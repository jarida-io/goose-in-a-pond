{
  "name": "pond-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n vite,server -c cyan,green \"vite\" \"npm run dev:server\"",
    "dev:server": "cd .. && cargo run -p pond-server -- serve",
    "dev:server:mesh": "cd .. && cargo run -p pond-server --features mesh -- serve",
    "dev:mesh": "concurrently --kill-others-on-fail -n vite,server -c cyan,green \"vite\" \"npm run dev:server:mesh\"",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "stage:server": "bash ../scripts/stage-server-sidecar.sh",
    "stage:server:stub": "bash ../scripts/stage-server-sidecar-stub.sh",
    "bundle:app": "npm run stage:server && npm run tauri build"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@jarida/ink": "^1.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-window-state": "^2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.40.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "happy-dom": "^20.11.12",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
