{
  "name": "pond-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "Privacy-first, fully local AI smart home assistant",
  "author": "Jarida Open Source Community",
  "license": "Apache-2.0",
  "main": "dist-electron/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n vite,server -c cyan,green \"vite\" \"npm run dev:server\"",
    "dev:server": "cd .. && cargo run -p pond-server -- serve",
    "dev:server:mesh": "cd .. && cargo run -p pond-server --features mesh -- serve",
    "dev:mesh": "concurrently --kill-others-on-fail -n vite,server -c cyan,green \"vite\" \"npm run dev:server:mesh\"",
    "dev:vite": "vite",
    "dev:electron": "concurrently --kill-others-on-fail -n vite,main,shell -c cyan,yellow,magenta \"vite\" \"tsup --watch\" \"wait-on tcp:1420 dist-electron/main/index.cjs && GIAP_DEV_SERVER=http://localhost:1420 electron .\"",
    "build": "vite build",
    "build:main": "tsup",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "stage:server": "bash ../scripts/stage-server-sidecar.sh",
    "bundle:app": "npm run stage:server && npm run build:main && bash ../scripts/verify-sidecar.sh && electron-builder --mac",
    "pack:dir": "npm run stage:server && npm run build:main && bash ../scripts/verify-sidecar.sh && electron-builder --mac dir"
  },
  "dependencies": {
    "@fontsource-variable/comfortaa": "^5.3.0",
    "@fontsource-variable/quicksand": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@jarida/ink": "^1.0.0",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.12",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
