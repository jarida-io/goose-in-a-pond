# Generated by Cargo
# will have compiled files and executables
debug
target
**/target
**/debug
**/release

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
.idea/
whisper.cpp/
# The pinned, patched Whisper crate must include its published native sources.
!/vendor/whisper-rs-sys/whisper.cpp/
!/vendor/whisper-rs-sys/whisper.cpp/**
node_modules/
.ai/
.ai/*{txt,md,log}
**/scratchpad.md

# macOS Finder cruft
.DS_Store
**/.DS_Store

# Local server logs (rotated to disk in dev mode)
llama.log
**/llama.log

# Local editor / agent session state
.claude/
.vscode/

# Agent guidance is personal and stays out of the tree. Keep a local AGENTS.md
# (and a CLAUDE.md if your tooling wants one) for your own notes and setup;
# neither is ever committed.
/AGENTS.md
/CLAUDE.md

# Playwright MCP / Vite dev caches
.playwright-mcp/
.vite/

**/*.log
/boop-agent-main/

# Off-device Jetson cross-build output (aarch64 target dir; kept locally as a
# build cache but never committed — see scripts/build-jetson-docker.sh)
/target-jetson/

# Throwaway verification screenshots dropped at the repo root by Playwright /
# manual UI checks (real assets live under */src/assets/)
/*.png

# Regenerated Playwright output (report + last-run state) — pure test
# artifacts that churn on every run; never part of the source tree
pond-desktop/playwright-report/
pond-desktop/test-results/
__pycache__/

# Python virtualenvs under experiments/ — regenerable from the pipeline's own
# requirements, and the MLX/tokenizers native libraries alone are ~420 MB
**/.venv/

# Fine-tuning corpora emitted by experiments/dual-gemma/finetune/gen_data.py.
# Derived output, rebuilt by the generator, never reviewed by hand.
experiments/**/finetune/data/train.jsonl
experiments/**/finetune/data/valid.jsonl
